# Szablon — skopiuj do .env.development / .env.production (nie commituj).
# Przeglądarka NIE wczytuje tych plików; front: js/core/config.js (routing po hoście).
# Cloudflare Pages: ustaw SUPABASE_URL / SUPABASE_ANON_KEY w Dashboard (Preview vs Production).

# --- Staging (asxrsdsprrbvjvgcsckh) ---
VITE_SUPABASE_URL=https://asxrsdsprrbvjvgcsckh.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# --- Production (tawywecinkubmouyprab) ---
# VITE_SUPABASE_URL=https://tawywecinkubmouyprab.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_...
# VITE_STRIPE_PUBLIC_KEY=pk_live_...

# --- Supabase Edge Secrets (stripe-webhook → wFirma) ---
# WFIRMA_ACCESS_KEY=   # Ustawienia → Bezpieczeństwo → Aplikacje → Klucze API
# WFIRMA_SECRET_KEY=
# WFIRMA_APP_KEY=
# WFIRMA_COMPANY_ID=   # wymagane przy wielu firmach na koncie
# WFIRMA_VAT_RATE=23
# WFIRMA_ENABLED=true  # false = wyłącz wystawianie faktur
