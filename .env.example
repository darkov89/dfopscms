# Szablon — skopiuj do .env.development / .env.production (nie commituj).
# Przeglądarka NIE wczytuje tych plików w runtime; front: js/core/config.js (routing po hoście).
# Cloudflare Pages: ustaw SUPABASE_URL / SUPABASE_ANON_KEY w Dashboard (Preview vs Production).
# Supabase CLI: supabase secrets set … (Edge Functions).

# --- Staging (asxrsdsprrbvjvgcsckh) ---
SUPABASE_URL=https://asxrsdsprrbvjvgcsckh.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
PUBLIC_TURNSTILE_SITE_KEY=your_site_key  # Publikowalny klucz Cloudflare Turnstile (frontend)
STRIPE_PUBLIC_KEY=pk_test_...

# --- Production (tawywecinkubmouyprab) ---
# SUPABASE_URL=https://tawywecinkubmouyprab.supabase.co
# SUPABASE_ANON_KEY=sb_publishable_...
# STRIPE_PUBLIC_KEY=pk_live_...

# --- Supabase Edge Secrets (stripe-webhook → wFirma) ---
# WFIRMA_ACCESS_KEY=
# WFIRMA_SECRET_KEY=
# WFIRMA_APP_KEY=
# WFIRMA_COMPANY_ID=
# WFIRMA_VAT_RATE=23
# WFIRMA_ENABLED=true
# WFIRMA_TRANSLATION_LANG_EN_ID=  # opcjonalnie; bez tego API szuka pol-ang
# STRIPE_AUTOMATIC_TAX=true       # Stripe Tax w Dashboard + rejestracja PL (Live/Test osobno)

# --- DFCMS SECURITY SECRETS GUIDE ---
# PUBLIC / browser-safe values
# These may be exposed in static frontend config or Cloudflare Pages env.
# Supabase anon key is public by design, but access must still be constrained by RLS.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# SERVER-ONLY / never commit real values
# Configure these only as Supabase Edge Function secrets or Cloudflare protected env vars.
SUPABASE_SERVICE_ROLE_KEY=
TURNSTILE_SECRET_KEY=your_secret_key  # Serwerowy klucz Cloudflare Turnstile (Edge Functions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_AUTOMATIC_TAX=false
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
CF_ZONE_ID=
CF_API_TOKEN=
GOOGLE_MAPS_API_KEY=
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WFIRMA_ENABLED=false
WFIRMA_ACCESS_KEY=
WFIRMA_SECRET_KEY=
WFIRMA_APP_KEY=
WFIRMA_COMPANY_ID=
WFIRMA_VAT_RATE=23

# SECURITY NOTE
# Do not place SERVICE_ROLE, Stripe secret/webhook keys, Cloudflare tokens,
# Google API keys, Telegram tokens or wFirma credentials in browser JS.
